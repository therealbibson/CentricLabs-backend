# Copy this file to .env when you want to use MongoDB locally.
# Do NOT commit a real .env file, and never put real credentials in the repo.
# The backend works without this — it falls back to in-memory sample data.

# Local MongoDB (default database name: centriclabs)
MONGODB_URI=mongodb://localhost:27017/centriclabs

# Admin dashboard password for POST /api/admin/login.
# Demo default for local development ONLY — change this before any real
# deployment. The frontend admin login uses this password.
ADMIN_PASSWORD=admin123

# API port (default 4000)
PORT=4000
